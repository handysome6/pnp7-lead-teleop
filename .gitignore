# Recorded episodes, 2.3 GB on the control PC. Data lives there, not here.
episodes/

# Vendored upstream SDK, 43 MB. Cloned separately; see README.
DynamixelSDK/

# Build products and environments.
bin/
.venv/
# pixi's materialised environment (several hundred MB of packages).
# pixi.lock is tracked on purpose -- it is the reproducible half.
.pixi/
__pycache__/
*.pyc
*.so
*.egg-info/
.DS_Store

# Ad-hoc backups. Git already keeps the history these were standing in for --
# they were made before this tree was under version control. Kept on disk on
# the machines that have them, but not carried in the repo.
*.bak
*.bak-*
*.bak_*
*.bad_*
conf-bak-*/

# Screenshots, extracted dataset frames and generated figures. Debugging
# leftovers and script output, regenerable, and one of them is 2.1 MB. No image
# is tracked, so these patterns shadow nothing.
*.png
*.jpg

# Analysis output. 165 MB, mostly copies of 1 kHz episode CSVs pulled off the
# control PC for offline work, which the episodes themselves are already the
# source of. The write-ups that are meant to last live in docs/ with their
# evidence JSON beside them, the way the 2026-09-09 audit did it.
artifacts/

# Ad-hoc recordings made outside the GUI's episodes/ directory -- same kind of
# data, same reason to keep it off the repo.
test_jitter/

# A staged copy of upstream RLinf, kept for reference while reworking the
# executor. Vendored third-party source, like DynamixelSDK above.
.codex_rlinf_stage/

# Run artefacts written next to the code by default.
/dry.csv
/run.csv
*_run.csv
