# OpenEB 5.3.0（Prophesee Metavision 开源版）运行环境。
#
# 为什么用容器：OpenEB 5.3 要求 Ubuntu 22.04/24.04 与 Python 3.9+，而 franka-sz
# 是 Ubuntu 20.04 + Python 3.8。那台机器跑着实时内核、FCI 和已验证的遥操作系统，
# 为装 SDK 去升级系统风险远大于收益。
#
# 时间同步不受影响：容器与宿主共享内核，CLOCK_MONOTONIC 是同一个时钟源，
# 所以容器内的事件时间戳与宿主上 RealSense / 机器人状态的时间戳直接可比。
#
# 只编译 OpenEB（HAL + Prophesee 相机插件 + SDK + Python 绑定），不含 advanced
# SDK 与 ML 模型——录制和读取事件流用不到，那两个包合计超过 1 GB。
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONNOUSERSITE=true

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential software-properties-common wget unzip curl git cmake \
        libopencv-dev libboost-all-dev libusb-1.0-0-dev \
        libprotobuf-dev protobuf-compiler \
        libhdf5-dev hdf5-tools libglew-dev libglfw3-dev ffmpeg \
        python3-pip python3-dev python3-distutils \
        udev usbutils \
    && rm -rf /var/lib/apt/lists/*

# pybind11 必须是 2.11.0，且没有预编译包可用。
RUN wget -q https://github.com/pybind/pybind11/archive/v2.11.0.zip \
    && unzip -q v2.11.0.zip \
    && cmake -S pybind11-2.11.0 -B /tmp/pb11 -DPYBIND11_TEST=OFF \
    && cmake --build /tmp/pb11 --target install -j"$(nproc)" \
    && rm -rf pybind11-2.11.0 v2.11.0.zip /tmp/pb11

COPY openeb-5.3.0 /openeb-src

RUN python3 -m pip install --no-cache-dir --upgrade pip \
    && python3 -m pip install --no-cache-dir \
       -r /openeb-src/utils/python/requirements_openeb.txt

RUN cmake -S /openeb-src -B /openeb-src/build \
        -DBUILD_TESTING=OFF \
        -DCMAKE_BUILD_TYPE=Release \
    && cmake --build /openeb-src/build --config Release -j"$(nproc)" \
    && cmake --build /openeb-src/build --target install \
    && ldconfig \
    && rm -rf /openeb-src/build

ENV MV_HAL_PLUGIN_PATH=/usr/local/lib/metavision/hal/plugins
ENV PYTHONPATH=/usr/local/lib/python3/dist-packages:$PYTHONPATH

CMD ["/bin/bash"]
