"""EVK4 实时预览（macOS），用于挑镜头时判断视场与畸变。

两个 macOS 特有的性能问题，都是实测出来的：

1. cv2.waitKey(1) 名义等 1 ms，实际要 13.95 ms —— Cocoa 事件循环的固定开销，
   占了每批耗时的 67%。delta_t 只有 20 ms，每批都刷新会让总耗时 20.71 ms
   超出预算，于是每秒积压约 0.1 秒延迟，一分钟后就是肉眼可见的 3-5 秒滞后。
   解法是把显示帧率和事件读取解耦：事件照常按 delta_t 全读，只是每 N 批
   才刷一次屏，把 waitKey 的固定开销摊薄。

2. 两个坏点（热像素）占事件量的 83.7%，不滤掉等于把处理量放大 6 倍。

事件相机只对亮度变化响应，静止场景是全黑的，所以用带衰减的累积而非单帧
事件图 —— 晃动相机时整个场景的边缘会像线稿一样浮现，判断视场最直观。

按键:
  q / ESC  退出        d  切换 衰减累积 / 原始事件
  g        网格开关    s  保存当前画面
  + / -    调整衰减    r  重置累积
"""
from __future__ import annotations

import argparse
import os
import time

import cv2
import numpy as np
from metavision_core.event_io import EventsIterator

# Linux 上实测的坏点坐标（同一台相机）。位置会随温度漂移，长期使用应重测。
HOT_PIXELS = [(1270, 229), (994, 484)]


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--delta-t", type=int, default=20000)
    ap.add_argument("--decay", type=float, default=0.92)
    ap.add_argument("--scale", type=float, default=0.9)
    ap.add_argument("--seconds", type=float, default=0.0)
    ap.add_argument("--fps", type=float, default=20.0,
                    help="画面刷新率上限。按时间节流而非按批数——EventsIterator "
                         "的批数不可控：看 10 Hz 闪烁图案时事件呈突发式，"
                         "12 秒内返回了 2278 批而非预期的 600 批（多数是空批），"
                         "按批数节流会让刷新次数翻几倍，waitKey 的固定开销"
                         "（macOS 上 4.6 ms/次）随之爆掉。")
    ap.add_argument("--no-hot-filter", action="store_true")
    args = ap.parse_args()

    hot = [] if args.no_hot_filter else HOT_PIXELS

    it = EventsIterator(input_path="", delta_t=args.delta_t)
    h, w = it.get_size()
    show_interval = 1.0 / args.fps
    print(f"EVK4 {w}x{h}   屏蔽 {len(hot)} 个坏点   显示上限 {args.fps:.0f} fps")
    print("事件相机只对变化响应——静止场景是黑的，晃动相机或在视野里挥手即可显形。\n")

    win = "EVK4 (macOS)  q:quit d:mode g:grid s:save +/-:decay r:reset"
    cv2.namedWindow(win, cv2.WINDOW_NORMAL)
    cv2.resizeWindow(win, int(w * args.scale), int(h * args.scale))

    surface = np.zeros((h, w), np.float32)
    last_pos = np.zeros((h, w), np.float32)
    last_neg = np.zeros((h, w), np.float32)
    decay, show_decay, show_grid = args.decay, True, True
    saved = 0
    n_recent, t_rate, rate = 0, time.monotonic(), 0.0
    t0 = last_show = time.monotonic()

    for evs in it:
        if len(evs):
            x, y, p = evs["x"], evs["y"], evs["p"]
            for hx, hy in hot:
                keep = ~((x == hx) & (y == hy))
                x, y, p = x[keep], y[keep], p[keep]
            n_recent += len(x)
            if len(x):
                # bincount 而非 np.add.at：后者是 unbuffered 散射累加，慢约 8 倍
                idx = y.astype(np.int64) * w + x
                pos = p == 1
                last_pos = np.bincount(
                    idx[pos], minlength=h * w).astype(np.float32).reshape(h, w)
                last_neg = np.bincount(
                    idx[~pos], minlength=h * w).astype(np.float32).reshape(h, w)
                if show_decay:
                    surface *= decay
                    surface += last_pos + last_neg

        # 按墙钟节流：无论 iterator 给出多少批，刷新率恒定，
        # waitKey 的固定开销不会随批数波动。
        now = time.monotonic()
        if now - last_show < show_interval:
            continue
        last_show = now
        if now - t_rate >= 0.5:
            rate = n_recent / (now - t_rate) / 1e6
            n_recent, t_rate = 0, now

        if show_decay:
            img = cv2.applyColorMap(
                np.clip(surface * 40, 0, 255).astype(np.uint8),
                cv2.COLORMAP_BONE)
        else:
            img = np.zeros((h, w, 3), np.uint8)
            img[..., 2] = np.clip(last_pos * 90, 0, 255)
            img[..., 0] = np.clip(last_neg * 90, 0, 255)

        if show_grid:
            for gx in range(1, 4):
                cv2.line(img, (w * gx // 4, 0), (w * gx // 4, h), (50, 50, 50), 1)
            for gy in range(1, 3):
                cv2.line(img, (0, h * gy // 3), (w, h * gy // 3), (50, 50, 50), 1)
            cx, cy = w // 2, h // 2
            cv2.line(img, (cx - 25, cy), (cx + 25, cy), (0, 200, 200), 1)
            cv2.line(img, (cx, cy - 25), (cx, cy + 25), (0, 200, 200), 1)

        cv2.rectangle(img, (0, 0), (w, 30), (0, 0, 0), -1)
        mode = f"decay {decay:.2f}" if show_decay else "raw"
        cv2.putText(img, f"{rate:5.2f} Mev/s   {mode}   {w}x{h}", (10, 21),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.6, (0, 255, 0), 1, cv2.LINE_AA)

        cv2.imshow(win, img)
        k = cv2.waitKey(1) & 0xFF
        if k in (ord("q"), 27):
            break
        elif k == ord("d"):
            show_decay = not show_decay
            surface[:] = 0
        elif k == ord("g"):
            show_grid = not show_grid
        elif k == ord("r"):
            surface[:] = 0
        elif k == ord("s"):
            saved += 1
            path = os.path.expanduser(f"~/metavision_mac/evk4_view_{saved:02d}.png")
            cv2.imwrite(path, img)
            print(f"已保存 {path}")
        elif k in (ord("+"), ord("=")):
            decay = min(0.99, decay + 0.01)
        elif k == ord("-"):
            decay = max(0.50, decay - 0.01)

        if args.seconds and time.monotonic() - t0 > args.seconds:
            break

    cv2.destroyAllWindows()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
